# ── Application ──────────────────────────────────────────────────────────────
VITE_APP_NAME=Ifilino
VITE_APP_TAGLINE=Vos commerces, vos envies, tout près de vous.

# ── URLs ─────────────────────────────────────────────────────────────────────
# Production : sous-domaine app
VITE_SITE_URL=https://ifilino.com
VITE_APP_URL=https://app.ifilino.com
VITE_PRO_URL=https://pro.ifilino.com

# API : pointer vers le sous-domaine api en production
# En dev local : http://localhost:3000/api
# En prod Nginx mono-serveur : /restobook/api/ (path relatif)
VITE_API_URL=https://api.ifilino.com

# ── Contact ───────────────────────────────────────────────────────────────────
VITE_SUPPORT_EMAIL=contact@ifilino.com

# ── PWA / Chemin public ───────────────────────────────────────────────────────
# Chemin de base Vite (laisser / quand on sert depuis la racine du domaine)
VITE_PUBLIC_BASE_PATH=/

# ── Domaine ───────────────────────────────────────────────────────────────────
VITE_DOMAIN_STATUS=active

# ── Auth Google (Google Identity Services) ────────────────────────────────────
# Client ID OAuth 2.0 "Web application" — même valeur que GOOGLE_CLIENT_ID côté
# backend. Voir GOOGLE_OAUTH_SETUP.md. Public par design (ce n'est pas un secret).
VITE_GOOGLE_CLIENT_ID=

# ── Notification Center — Push Web (FCM) ──────────────────────────────────────
# Config web Firebase (Project Settings > General > Your apps > SDK config) —
# ces valeurs sont publiques par design (pas des secrets), contrairement au
# compte de service backend (FCM_PRIVATE_KEY côté serveur uniquement).
VITE_FCM_API_KEY=
VITE_FCM_AUTH_DOMAIN=
VITE_FCM_PROJECT_ID=
VITE_FCM_MESSAGING_SENDER_ID=
VITE_FCM_APP_ID=
VITE_FCM_VAPID_KEY=
