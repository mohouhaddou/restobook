# ── Serveur ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── Base de données ───────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ifilino_db
DB_USER=ifilino_user
DB_PASS=changeme

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string

# ── Auth Google (Google Identity Services) ────────────────────────────────────
# Client ID OAuth 2.0 "Web application" créé dans Google Cloud Console.
# Voir GOOGLE_OAUTH_SETUP.md pour la procédure complète.
GOOGLE_CLIENT_ID=

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Ifilino
APP_URL=https://ifilino.com
API_URL=https://api.ifilino.com
PUBLIC_BASE_URL=https://ifilino.com
ASSET_BASE=https://ifilino.com

# ── Email ─────────────────────────────────────────────────────────────────────
SUPPORT_EMAIL=contact@ifilino.com
CONTACT_EMAIL=contact@ifilino.com
NOREPLY_EMAIL=noreply@ifilino.com
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=contact@ifilino.com
SMTP_PASS=changeme

# ── Branding ──────────────────────────────────────────────────────────────────
DEFAULT_LOGO_URL=/brand/ifilino_light.png

# ── Features ──────────────────────────────────────────────────────────────────
ALLOW_SELF_SIGNUP=true

# ── iFilino Discover — moteur IA de brouillons ────────────────────────────────
# Clé API OpenAI serveur. Laisser vide = génération IA désactivée
# (erreur explicite côté admin, aucun crash). Ne jamais exposer côté frontend.
OPENAI_API_KEY=
# Modèle configurable pour la génération éditoriale. Défaut côté code : gpt-5-mini.
OPENAI_MODEL=

# ── Notification Center — Push Web (FCM) ──────────────────────────────────────
# Compte de service Firebase (Project Settings > Service accounts > Generate
# new private key). Laisser vide = mode stub (log en dev, aucun envoi réel).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
