{
  "version": "1.0.0",
  "environment": "default",
  "workspace": { "root": "workspace", "temporary": "workspace/temp" },
  "logs": { "directory": "workspace/logs", "level": "info" },
  "retry": { "maxAttempts": 3, "baseDelayMs": 1000, "backoffMultiplier": 2 },
  "scheduler": { "enabled": true, "concurrency": 1 },
  "publisher": { "requireImages": true, "dryRun": true },
  "orchestrator": { "autoStart": true, "archiveOnSuccess": true },
  "modules": {
    "workflowEngine": true,
    "publisherEngine": true,
    "contentManager": true,
    "fileSystem": true,
    "integration": true,
    "aiPublisher": true,
    "orchestrator": true
  },
  "featureFlags": {
    "notifications": false,
    "webhooks": false,
    "slack": false,
    "discord": false,
    "email": false
  }
}
