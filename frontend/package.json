{
  "name": "restobook-frontend",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "verify:dist": "node scripts/verify-dist-assets.mjs dist",
    "deploy:production": "../scripts/deploy-frontend.sh",
    "typecheck:ai": "tsc -p tsconfig.ai.json",
    "lint:ai": "eslint -c eslint.ai.config.mjs src/modules/ai-command-center src/modules/ai-package-import",
    "build:ssr": "vite build --ssr src/entry-server.jsx --outDir dist-server",
    "i18n:coverage": "node scripts/check-i18n-coverage.mjs",
    "i18n:audit": "node scripts/audit-i18n-hardcoded.mjs",
    "preview": "vite preview",
    "render-build": "npm run build",
    "test:markdown": "vitest run --config vitest.config.js"
  },
  "dependencies": {
    "@ifilino/shared": "file:../packages/shared",
    "bootstrap": "^5.3.8",
    "firebase": "^12.15.0",
    "framer-motion": "^12.42.0",
    "html5-qrcode": "^2.3.8",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "lucide-react": "^1.24.0",
    "phaser": "^3.90.0",
    "pm2": "^6.0.13",
    "qrcode": "^1.5.3",
    "react": "^18",
    "react-dom": "^18",
    "react-router-dom": "^7.17.0",
    "recharts": "^3.9.1",
    "serve": "^14.2.5",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^10.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^5.4.20",
    "vitest": "^4.1.10"
  }
}
