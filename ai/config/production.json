{
  "version": "1.0.0",
  "environment": "production",
  "workspace": { "root": "workspace", "temporary": "workspace/temp" },
  "logs": { "directory": "workspace/logs", "level": "warning" },
  "retry": { "maxAttempts": 5, "baseDelayMs": 2000, "backoffMultiplier": 2 },
  "scheduler": { "enabled": true, "concurrency": 4 },
  "publisher": { "requireImages": true, "dryRun": false },
  "orchestrator": { "autoStart": true, "archiveOnSuccess": true },
  "modules": {
    "workflowEngine": true,
    "publisherEngine": true,
    "contentManager": true,
    "fileSystem": true,
    "integration": true,
    "aiPublisher": true,
    "orchestrator": true
  },
  "featureFlags": { "notifications": false, "webhooks": false, "slack": false, "discord": false, "email": false }
}
