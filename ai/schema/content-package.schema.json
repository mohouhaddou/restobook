{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-package.schema.json",
  "title": "iFilino Content Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "editor",
    "category",
    "language",
    "createdAt",
    "updatedAt",
    "articleMarkdown",
    "sections",
    "metadata",
    "images",
    "seo",
    "workflow",
    "version",
    "status"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "editor": { "enum": ["discover", "sports", "kids", "stories", "gaming"] },
    "category": { "type": "string", "minLength": 1 },
    "language": { "enum": ["fr", "ar", "en"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "articleMarkdown": { "type": "string", "minLength": 1 },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "level", "content"],
        "properties": {
          "heading": { "type": "string", "minLength": 1 },
          "level": { "enum": [2, 3, 4, 5, 6] },
          "content": { "type": "string", "minLength": 1 },
          "imageReference": { "type": "string", "minLength": 1 }
        }
      }
    },
    "metadata": { "$ref": "metadata.schema.json" },
    "images": { "$ref": "images.schema.json" },
    "seo": { "$ref": "seo.schema.json" },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["editor", "steps", "version"],
      "properties": {
        "editor": { "enum": ["discover", "sports", "kids", "stories", "gaming"] },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "order", "status", "requiresHumanReview"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "name": { "type": "string", "minLength": 1 },
              "order": { "type": "integer", "minimum": 1 },
              "status": { "enum": ["pending", "completed", "skipped", "failed"] },
              "requiresHumanReview": { "type": "boolean" }
            }
          }
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        }
      }
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": ["draft", "review", "approved", "queued", "published", "failed"]
    }
  }
}
